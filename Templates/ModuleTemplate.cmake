# ==============================================================================
# Copied into <Project>/Source/<Module>/CMakeLists.txt on every configure.
# Never edit that copy: this file is the source of truth.
#
# <Module>.h and <Module>.cpp are created once, then belong to the author.
# They are boilerplate: gameplay code goes in its own files, lifecycle overrides
# go in <Module>.cpp (Core's PrepareModule is the one example in the tree).
# ==============================================================================

get_filename_component(MODULE_NAME "${CMAKE_CURRENT_SOURCE_DIR}" NAME)

if(NOT MODULE_NAME MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR
            "[VEngine] Module folder '${MODULE_NAME}' is not a valid C++ identifier. "
            "The folder name becomes the class name F${MODULE_NAME}Module, so rename the folder.")
endif()

set(QUALIFIED_MODULE_NAME "${PARENT_PROJECT_NAME}_${MODULE_NAME}")
set(UNIQUE_TARGET_NAME "Module_${QUALIFIED_MODULE_NAME}")

set(PUBLIC_DIR  "${CMAKE_CURRENT_SOURCE_DIR}/Public")
set(PRIVATE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Private")
set(MODULE_CORE_H   "${PUBLIC_DIR}/${MODULE_NAME}.h")
set(MODULE_CORE_CPP "${PRIVATE_DIR}/${MODULE_NAME}.cpp")

file(MAKE_DIRECTORY "${PUBLIC_DIR}")
file(MAKE_DIRECTORY "${PRIVATE_DIR}")

if(NOT EXISTS "${MODULE_CORE_H}")
    file(WRITE "${MODULE_CORE_H}"
            "#pragma once\n\n"
            "#include \"${MODULE_NAME}API.h\"\n\n"
            "// Module-wide public header, and the module's precompiled header.\n"
            "// Add module-wide includes here; put classes in their own headers.\n"
    )
endif()

# Created once and never overwritten on purpose: this is where a module's lifecycle
# overrides live, so regenerating it would silently delete them.
if(NOT EXISTS "${MODULE_CORE_CPP}")
    file(WRITE "${MODULE_CORE_CPP}"
            "// ==============================================================================\n"
            "// MODULE BOILERPLATE - generated once by Templates/ModuleTemplate.cmake.\n"
            "//\n"
            "// You normally do not edit this file. A module lifecycle override belongs here,\n"
            "// and only here: see Engine/Source/Core/Private/Core.cpp for the one example in\n"
            "// the tree (PrepareModule initialising the object registry).\n"
            "// ==============================================================================\n"
            "#include \"${MODULE_NAME}.h\"\n"
            "#include \"Core.h\"\n"
            "#include \"Modules/ModuleInterface.h\"\n\n"
            "class F${MODULE_NAME}Module : public IModuleInterface\n"
            "{\n"
            "public:\n"
            "    bool StartupModule() override\n"
            "    {\n"
            "        VENGINE_LOG(LogCore, Info, \"[${QUALIFIED_MODULE_NAME}] Module started!\");\n"
            "        return true;\n"
            "    }\n\n"
            "    void ShutdownModule() override\n"
            "    {\n"
            "        VENGINE_LOG(LogCore, Info, \"[${QUALIFIED_MODULE_NAME}] Module shutting down!\");\n"
            "    }\n"
            "};\n\n"
            "IMPLEMENT_MODULE(F${MODULE_NAME}Module)\n"
    )
endif()

set(LOADING_PHASE "PostEngineInit")
set(PUBLIC_DEPENDENCY_MODULES "")
set(PRIVATE_DEPENDENCY_MODULES "")
set(PUBLIC_THIRD_PARTY_DEPENDENCIES "")
set(THIRD_PARTY_DEPENDENCIES "")
set(PRECOMPILE_HEADERS "")
include("${CMAKE_CURRENT_SOURCE_DIR}/Build.cmake")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Build.cmake")

# Automated Self-Link Protection Pass
set(SELF_ALIAS  "${PARENT_PROJECT_NAME}::${MODULE_NAME}")
list(REMOVE_ITEM PUBLIC_DEPENDENCY_MODULES  "${SELF_ALIAS}" "${UNIQUE_TARGET_NAME}" "${MODULE_NAME}")
list(REMOVE_ITEM PRIVATE_DEPENDENCY_MODULES "${SELF_ALIAS}" "${UNIQUE_TARGET_NAME}" "${MODULE_NAME}")

# Register Module Metadata for Topological Boot Sorting & Phase Validation
set_property(GLOBAL APPEND PROPERTY "VENGINE_ALL_REGISTERED_MODULES" "${UNIQUE_TARGET_NAME}")
set_property(GLOBAL PROPERTY "${UNIQUE_TARGET_NAME}_QUALIFIED_NAME" "${QUALIFIED_MODULE_NAME}")
set_property(GLOBAL PROPERTY "${UNIQUE_TARGET_NAME}_PHASE" "${LOADING_PHASE}")
set_property(GLOBAL PROPERTY "${UNIQUE_TARGET_NAME}_DEPS" "${PUBLIC_DEPENDENCY_MODULES};${PRIVATE_DEPENDENCY_MODULES}")

# Harvest Source & Header Files
file(GLOB_RECURSE SOURCE_FILES LIST_DIRECTORIES false CONFIGURE_DEPENDS "${PRIVATE_DIR}/*.cpp")
file(GLOB_RECURSE HEADER_FILES LIST_DIRECTORIES false CONFIGURE_DEPENDS "${PUBLIC_DIR}/*.h" "${PUBLIC_DIR}/*.hpp")

# Target Runtime Registration
add_library(${UNIQUE_TARGET_NAME} SHARED ${SOURCE_FILES} ${HEADER_FILES})
target_compile_definitions(${UNIQUE_TARGET_NAME} PRIVATE
        VENGINE_CURRENT_MODULE_NAME="${QUALIFIED_MODULE_NAME}"
)
add_library(${PARENT_PROJECT_NAME}::${MODULE_NAME} ALIAS ${UNIQUE_TARGET_NAME})

set_target_properties(${UNIQUE_TARGET_NAME} PROPERTIES
        OUTPUT_NAME "VEngine-${PARENT_PROJECT_NAME}-${MODULE_NAME}"
        FOLDER "Modules/${PARENT_PROJECT_NAME}"
)

include(GenerateExportHeader)
generate_export_header(${UNIQUE_TARGET_NAME}
        EXPORT_FILE_NAME "${CMAKE_CURRENT_BINARY_DIR}/Public/${MODULE_NAME}API.h"
        EXPORT_MACRO_NAME "${MODULE_NAME}_API"
        NO_EXPORT_MACRO_NAME "${MODULE_NAME}_PRIVATE"
        DEPRECATED_MACRO_NAME "${MODULE_NAME}_DEPRECATED"
)

target_include_directories(${UNIQUE_TARGET_NAME}
        PUBLIC  "${PUBLIC_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/Public"
        PRIVATE "${PRIVATE_DIR}"
)

target_precompile_headers(${UNIQUE_TARGET_NAME} PRIVATE "${MODULE_CORE_H}")
if(PRECOMPILE_HEADERS)
    target_precompile_headers(${UNIQUE_TARGET_NAME} PRIVATE ${PRECOMPILE_HEADERS})
endif()

if(PUBLIC_DEPENDENCY_MODULES)
    target_link_libraries(${UNIQUE_TARGET_NAME} PUBLIC ${PUBLIC_DEPENDENCY_MODULES})
endif()
if(PRIVATE_DEPENDENCY_MODULES)
    target_link_libraries(${UNIQUE_TARGET_NAME} PRIVATE ${PRIVATE_DEPENDENCY_MODULES})
endif()
if(PUBLIC_THIRD_PARTY_DEPENDENCIES)
    target_link_libraries(${UNIQUE_TARGET_NAME} PUBLIC ${PUBLIC_THIRD_PARTY_DEPENDENCIES})
endif()
if(THIRD_PARTY_DEPENDENCIES)
    target_link_libraries(${UNIQUE_TARGET_NAME} PRIVATE ${THIRD_PARTY_DEPENDENCIES})
endif()